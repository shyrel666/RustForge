{
  "schema_version": 1,
  "pack_id": "builtin",
  "version": "1.0.0",
  "source": "rustforge-builtin",
  "description": "RustForge 内置被动规则包：本地初筛打标，结论一律待人工验证。",
  "rules": [
    {
      "rule_id": "sensitive-param-in-url",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "URL 中出现敏感参数",
      "description": "URL 查询串疑似携带口令/密钥类参数。URL 会被代理、网关、浏览器历史记录，敏感值不应放在 URL 里。",
      "verify_hint": "在详情中查看 URL 参数，确认参数值是否真是凭据；再用 Repeater 重放看服务端是否接受。",
      "severity": "medium",
      "confidence": 70,
      "tag": "敏感参数",
      "vuln_type": "敏感信息通过 URL 传输",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A02" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-598" }
      ],
      "condition": {
        "operator": "regex",
        "selector": {
          "target": "query",
          "extractor": { "kind": "query", "field": "name" }
        },
        "pattern": "(?i)^(pass(wd|word)?|pwd|secret|token|api[-_]?key|access[-_]?token|auth[-_]?token|session[-_]?id)$"
      }
    },
    {
      "rule_id": "password-in-request-body",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "请求体携带口令字段",
      "description": "请求体中出现 password 类字段。本身不必然有问题，但应确认传输加密、服务端不记录明文日志。",
      "verify_hint": "确认该请求走 HTTPS；检查响应/后续请求里口令是否被回显或日志泄露。",
      "severity": "low",
      "confidence": 50,
      "tag": "口令字段",
      "vuln_type": "口令传输观察点",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A02" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-319" }
      ],
      "condition": {
        "operator": "any",
        "conditions": [
          {
            "operator": "regex",
            "selector": {
              "target": "request_body",
              "extractor": { "kind": "form", "field": "name" }
            },
            "pattern": "(?i)^(pass(wd|word)?|pwd)$"
          },
          {
            "operator": "regex",
            "selector": { "target": "request_body" },
            "pattern": "(?i)\"(pass(wd|word)?|pwd)\"\\s*:\\s*\""
          }
        ]
      }
    },
    {
      "rule_id": "jwt-exposed",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "JWT Token",
      "description": "流量中发现 JWT。解码 payload 可获用户信息；重点关注算法混淆（alg=none）与弱密钥风险。",
      "verify_hint": "把 JWT 拿到 jwt.io 解码看 payload 泄露了什么；尝试 alg=none/弱密钥爆破（仅授权目标）。",
      "severity": "info",
      "confidence": 90,
      "tag": "JWT",
      "vuln_type": "JWT 使用点",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A02" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-345" }
      ],
      "condition": {
        "operator": "any",
        "conditions": [
          {
            "operator": "regex",
            "selector": { "target": "request_header" },
            "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}"
          },
          {
            "operator": "regex",
            "selector": { "target": "request_body" },
            "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}"
          }
        ]
      }
    },
    {
      "rule_id": "sql-error-leak",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "SQL 错误信息泄露",
      "description": "响应包含数据库报错。说明输入可能拼接进 SQL 且错误未处理——SQL 注入的高价值线索。",
      "verify_hint": "对比正常/异常输入的响应差异；手工在参数后加引号观察报错变化；确认数据库类型后再深入。",
      "severity": "high",
      "confidence": 75,
      "tag": "SQL报错",
      "vuln_type": "SQL 注入线索",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A03" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-89" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "response_body" },
        "pattern": "(?i)(SQL syntax.*MySQL|You have an error in your SQL syntax|ORA-[0-9]{4,}|PostgreSQL.*ERROR|SQLite3?::|SQLite error|Unclosed quotation mark|Microsoft OLE DB Provider for SQL Server|pg_query\\(\\))"
      }
    },
    {
      "rule_id": "stack-trace-leak",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "错误堆栈泄露",
      "description": "响应包含应用堆栈/框架错误页，泄露代码路径、组件版本等内部信息，可能伴随调试接口。",
      "verify_hint": "阅读堆栈定位框架与版本；检查是否有 debug 开关；尝试触发更多异常路径收集信息。",
      "severity": "medium",
      "confidence": 70,
      "tag": "堆栈泄露",
      "vuln_type": "错误信息泄露",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-209" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "response_body" },
        "pattern": "(?i)(Traceback \\(most recent call last\\)|at [a-zA-Z0-9_.$]+\\([A-Za-z0-9_]+\\.java:\\d+\\)|System\\.[A-Za-z.]*Exception|NullReferenceException|Whoops, looks like something went wrong|laravel|django\\.core\\.exceptions)"
      }
    },
    {
      "rule_id": "debug-actuator-endpoint",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "调试/监控端点",
      "description": "路径疑似 actuator/metrics/health 等运维端点，可能泄露环境变量、线程转储甚至支持远程操作。",
      "verify_hint": "逐个访问确认是否未授权可读；重点看 /actuator/env、/actuator/heapdump、/metrics。",
      "severity": "medium",
      "confidence": 60,
      "tag": "调试端点",
      "vuln_type": "敏感端点暴露",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-1188" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "url" },
        "pattern": "(?i)/(actuator|metrics|debug|trace|dump|__debug__|_profiler|server-status|server-info)(/|$|\\?)"
      }
    },
    {
      "rule_id": "admin-console-path",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "后台管理路径",
      "description": "路径疑似管理后台/控制台。本身无害，但应确认有强认证与访问控制，避免弱口令直入。",
      "verify_hint": "确认是否需要登录；尝试默认口令组合前请确认授权范围；留意后台接口是否单独鉴权。",
      "severity": "info",
      "confidence": 50,
      "tag": "后台路径",
      "vuln_type": "管理后台暴露面",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A07" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-306" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "url" },
        "pattern": "(?i)/(admin|administrator|manager|manage|phpmyadmin|wp-admin|console|backstage|dashboard)(/|$|\\?)"
      }
    },
    {
      "rule_id": "sensitive-file-access",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "敏感文件/备份文件",
      "description": "路径指向 .git/.env/备份/swap 等文件，可能直接泄露源码、配置与密钥。",
      "verify_hint": "确认是否真实可下载；.git 泄露可尝试用工具完整还原仓库；.env 重点找数据库/AK 密钥。",
      "severity": "medium",
      "confidence": 65,
      "tag": "敏感文件",
      "vuln_type": "敏感文件暴露",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-538" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "url" },
        "pattern": "(?i)(/\\.(git|env|svn|hg|DS_Store|idea|vscode)|\\.(bak|swp|swo|old|orig|save|sql|dump|log|ini|conf|config)(\\?|$|/))"
      }
    },
    {
      "rule_id": "path-traversal-param",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "路径穿越特征参数",
      "description": "URL 参数出现 ../ 或其编码形式，可能存在任意文件读取。",
      "verify_hint": "手工尝试 ../ 变体（....//、%2e%2e%2f、绝对路径）读取 /etc/passwd 或 win.ini，对比响应长度变化。",
      "severity": "medium",
      "confidence": 65,
      "tag": "路径穿越",
      "vuln_type": "路径穿越线索",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A01" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-22" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "url" },
        "pattern": "(?i)(\\.\\./|\\.\\.\\\\|%2e%2e|%252e|\\.\\.;)"
      }
    },
    {
      "rule_id": "cors-wildcard",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "CORS 通配符",
      "description": "响应 Access-Control-Allow-Origin: *。若同时允许携带凭据或接口返回敏感数据，可被跨域读取。",
      "verify_hint": "检查是否有 Access-Control-Allow-Credentials 与敏感响应；构造恶意 Origin 看是否被反射。",
      "severity": "low",
      "confidence": 60,
      "tag": "CORS",
      "vuln_type": "CORS 配置宽松",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-942" }
      ],
      "condition": {
        "operator": "regex",
        "selector": {
          "target": "response_header",
          "name": "access-control-allow-origin"
        },
        "pattern": "^\\s*\\*\\s*$"
      }
    },
    {
      "rule_id": "cookie-no-httponly",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "Cookie 缺少 HttpOnly",
      "description": "Set-Cookie 未带 HttpOnly，XSS 发生时可被脚本直接读取会话。逐条 Set-Cookie 独立判定，其它 Cookie 带了 HttpOnly 不会掩盖本条缺失。",
      "verify_hint": "确认该 Cookie 是否为会话凭据；结合 XSS 面评估实际风险。",
      "severity": "low",
      "confidence": 65,
      "tag": "Cookie",
      "vuln_type": "Cookie 安全属性缺失",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-1004" }
      ],
      "condition": {
        "operator": "for_each",
        "target": "response_cookie",
        "condition": {
          "operator": "missing",
          "selector": {
            "target": "response_cookie",
            "extractor": {
              "kind": "cookie",
              "field": "attribute",
              "attribute": "httponly"
            }
          }
        }
      }
    },
    {
      "rule_id": "cookie-no-secure",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "Cookie 缺少 Secure",
      "description": "Set-Cookie 未带 Secure，HTTPS 站点会话可能被降级到明文传输。逐条 Set-Cookie 独立判定，其它 Cookie 带了 Secure 不会掩盖本条缺失。",
      "verify_hint": "确认站点是否存在 HTTP 入口；检查 HSTS 是否启用。",
      "severity": "low",
      "confidence": 65,
      "tag": "Cookie",
      "vuln_type": "Cookie 安全属性缺失",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A02" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-614" }
      ],
      "condition": {
        "operator": "for_each",
        "target": "response_cookie",
        "condition": {
          "operator": "missing",
          "selector": {
            "target": "response_cookie",
            "extractor": {
              "kind": "cookie",
              "field": "attribute",
              "attribute": "secure"
            }
          }
        }
      }
    },
    {
      "rule_id": "server-version-leak",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "服务端版本信息泄露",
      "description": "Server/X-Powered-By 等响应头暴露具体版本，便于定向匹配已知漏洞。",
      "verify_hint": "记录组件与版本，对照 CVE 库确认是否有已公开漏洞影响该版本。",
      "severity": "info",
      "confidence": 70,
      "tag": "版本泄露",
      "vuln_type": "版本信息泄露",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-200" }
      ],
      "condition": {
        "operator": "any",
        "conditions": [
          {
            "operator": "regex",
            "selector": { "target": "response_header", "name": "server" },
            "pattern": "\\d+\\.\\d+"
          },
          {
            "operator": "regex",
            "selector": { "target": "response_header", "name": "x-powered-by" },
            "pattern": "\\d+\\.\\d+"
          },
          {
            "operator": "regex",
            "selector": {
              "target": "response_header",
              "name": "x-aspnet-version"
            },
            "pattern": "\\d+\\.\\d+"
          },
          {
            "operator": "regex",
            "selector": { "target": "response_header", "name": "x-generator" },
            "pattern": "\\d+\\.\\d+"
          }
        ]
      }
    },
    {
      "rule_id": "internal-ip-leak",
      "version": "1.0.0",
      "source": "rustforge-builtin",
      "name": "内网 IP 泄露",
      "description": "内容中出现 RFC1918 内网地址，暴露内部网络结构，可作为横向信息。",
      "verify_hint": "收集出现的内网段，结合 SSRF/重定向面评估是否可利用。",
      "severity": "info",
      "confidence": 55,
      "tag": "内网IP",
      "vuln_type": "内部信息泄露",
      "references": [
        { "framework": "owasp-top10", "version": "2021", "id": "A05" },
        { "framework": "cwe", "version": "4.20", "id": "CWE-200" }
      ],
      "condition": {
        "operator": "regex",
        "selector": { "target": "response_body" },
        "pattern": "(?-u:\\b)(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2[0-9]|3[0-1])\\.\\d{1,3}\\.\\d{1,3})(?-u:\\b)"
      }
    }
  ]
}
